# Go API'nin adresi. SSR'da sunucudan çağrılır.
NUXT_API_BASE=http://localhost:8080/api

# Siparişlerin düştüğü WhatsApp numarası (ülke kodlu, sadece rakam).
# Bu numara wa.me linklerinde herkese görünür — gizli değil.
NUXT_PUBLIC_WHATSAPP_NUMBER=905551234567

# Sitenin kendi adresi. WhatsApp mesajındaki ürün linki ve og:url bundan üretilir.
NUXT_PUBLIC_SITE_URL=http://localhost:3000

# İletişim sayfası bilgileri (spec §5.3 — settings tablosu Faz 2'ye ertelendi)
NUXT_PUBLIC_CONTACT_PHONE=0555 123 45 67
NUXT_PUBLIC_CONTACT_ADDRESS=Örnek Mah. Çiçek Sok. No:1, İstanbul
NUXT_PUBLIC_CONTACT_HOURS=Her gün 09:00 - 20:00
