# Production ortam değişkenleri — ÖRNEK.
# Kopyala: cp .env.prod.example .env.prod  ve gerçek değerleri doldur.
# .env.prod ASLA commit edilmez (.gitignore'da).

# ── Domain ──────────────────────────────────────────────────────────
# Gerçek domain (TLS bunun için alınır). Domain almadan lokal test için
# DEPLOYMENT.md'deki :80 talimatına bak.
SITE_DOMAIN=cicekci.com

# Sitenin tam adresi (https zorunlu — backend APP_ENV=production'da kontrol eder).
# og:url, WhatsApp linkleri, görsel URL'leri bundan üretilir.
SITE_URL=https://cicekci.com

# ── Veritabanı ──────────────────────────────────────────────────────
POSTGRES_USER=cicekci
# GÜÇLÜ bir şifre üret: openssl rand -base64 24
POSTGRES_PASSWORD=degistir-guclu-bir-sifre
POSTGRES_DB=cicekci

# Backend'in bağlantı dizesi — yukarıdaki değerlerle tutarlı olmalı.
# host 'postgres' (compose servis adı), sslmode=disable (iç ağ).
DATABASE_URL=postgres://cicekci:degistir-guclu-bir-sifre@postgres:5432/cicekci?sslmode=disable

# ── Güvenlik ────────────────────────────────────────────────────────
# JWT imzalama anahtarı — EN AZ 32 karakter. Üret: openssl rand -base64 32
JWT_SECRET=degistir-en-az-32-karakterlik-rastgele-anahtar

# ── İşletme bilgileri ───────────────────────────────────────────────
# Siparişlerin düştüğü WhatsApp numarası (ülke kodlu, sadece rakam).
WHATSAPP_NUMBER=905551234567

# İletişim sayfası (spec §5.3 — settings tablosu Faz 2'ye ertelendi).
CONTACT_PHONE=0555 123 45 67
CONTACT_ADDRESS=Örnek Mah. Çiçek Sok. No:1, İstanbul
CONTACT_HOURS=Her gün 09:00 - 20:00

# Teslimat ayarları (Faz 2). DEĞERLER ESNAFTAN ÖĞRENİLECEK.
DELIVERY_FEE=0
DELIVERY_SLOTS=09:00-12:00,12:00-15:00,15:00-18:00
SAME_DAY_CUTOFF=16:00
MAX_DELIVERY_DAYS=30
DELIVERY_DISTRICTS=Ödemiş,Tire,Bayındır,Kiraz,Beydağ

# İlçeye özel teslimat ücreti — "ilçe:ücret" çiftleri, virgülle ayrılmış.
# Listede olmayan ilçe DELIVERY_FEE'ye (genel ücret) düşer.
DELIVERY_FEES=Ödemiş:50,Tire:80,Bayındır:60
