DATABASE_URL=postgres://cicekci:cicekci@localhost:5433/cicekci?sslmode=disable
TEST_DATABASE_URL=postgres://cicekci:cicekci@localhost:5434/cicekci_test?sslmode=disable
JWT_SECRET=change-me-in-production-min-32-chars
# development veya production. production'da auth cookie Secure bayrağı
# alır ve SITE_URL'in https:// olması zorunlu tutulur.
APP_ENV=development
PORT=8080
WHATSAPP_NUMBER=905052178501
SITE_URL=http://localhost:3000

# İletişim sayfası (spec §5.3 — settings tablosu Faz 2'ye ertelendi).
CONTACT_PHONE=+90 553 614 00 63
CONTACT_ADDRESS=Atatürk, Şht. Adnan Menderes Blv. No:31/A, 35750 Ödemiş/İzmir
CONTACT_HOURS=Her gün 09:00 - 22:00

# Görsel saklama: local (geliştirme) veya r2 (production).
# ImageStore interface'i sayesinde ikisi arasında geçiş config değişikliği —
# kod değişmiyor.
STORAGE_DRIVER=local
UPLOAD_DIR=./uploads
UPLOAD_BASE_URL=http://localhost:8080/uploads

# STORAGE_DRIVER=r2 ise beşi de zorunlu
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=

# Teslimat ayarları (Faz 2). DEĞERLER ESNAFTAN ÖĞRENİLECEK.
DELIVERY_FEE=0
DELIVERY_SLOTS=09:00-12:00,12:00-15:00,15:00-18:00
SAME_DAY_CUTOFF=16:00
MAX_DELIVERY_DAYS=30
DELIVERY_DISTRICTS=Ödemiş,Tire,Bayındır,Kiraz,Beydağ

# İlçeye özel teslimat ücreti — "ilçe:ücret" çiftleri, virgülle ayrılmış.
# Listede olmayan ilçe DELIVERY_FEE'ye (genel ücret) düşer. Hepsini
# doldurmak zorunlu değil, esnaf öğrendikçe eklenir.
DELIVERY_FEES=Ödemiş:50,Tire:80,Bayındır:60

# PayTR ödeme (Faz 3). Anahtarlar boşsa mock provider (geliştirme) kullanılır.
PAYTR_MERCHANT_ID=
PAYTR_MERCHANT_KEY=
PAYTR_MERCHANT_SALT=
PAYTR_TEST_MODE=1
# Boşsa SITE_URL + /api/payment/callback olur. PayTR panelinde bildirim URL'i buna eşit olmalı.
PAYMENT_CALLBACK_URL=
